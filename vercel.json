{
  "rewrites": [
    {
      "source": "/berita/(.*)",
      "destination": "/api/index.py?__path__=berita/$1"
    },
    {
      "source": "/warta/(.*)",
      "destination": "/api/index.py?__path__=berita/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/static/index.html"
    }
  ]
}